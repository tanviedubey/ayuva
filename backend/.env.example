# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3001
# Least-privilege app role (see README). Placeholder only.
DATABASE_URL=postgresql://ayuva_app:REPLACE_WITH_PASSWORD@localhost:5432/ayuva
# Test DB must have a name ending in _test (tests wipe its public schema).
TEST_DATABASE_URL=postgresql://ayuva_app:REPLACE_WITH_PASSWORD@localhost:5432/ayuva_test
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_HOURS=24
# Origin the browser uses to reach the app (used for Origin checks and CORS).
APP_ORIGIN=http://localhost:3001
# Extra browser origins allowed by CORS (comma-separated). Leave empty for same-origin.
CORS_ORIGINS=
TRUST_PROXY=false
# LLM is optional. none | gemini | openai. App works safely with none.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
