{
  "name": "ayuva-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Ayuva API + PostgreSQL backend (educational Ayurveda + evidence platform)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed:samples": "node src/db/seed.js",
    "seed:samples:approve": "node src/db/seed.js --approve-samples",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test": "node scripts/test.mjs all"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}